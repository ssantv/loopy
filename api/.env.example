# --- Core configuration ---
# Secreto para firmar/encriptar; generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_NAME=Loopy
ENV=development
DEBUG=true

# --- Database ---
# Local por SQLite (dev rápido sin Docker) o Postgres (producción).
DATABASE_URL=sqlite+aiosqlite:///./loopy_dev.db
# Producción:
# DATABASE_URL=postgresql+asyncpg://loopy:secret@db:5432/loopy

# --- Security / sessions ---
# Arquitectura: sesiones con token opaco en BD, sin JWT.
SESSION_TOKEN_BYTES=32
SESSION_TTL_DAYS=30

# Rate limit del login (fuerza bruta): intentos fallidos por (email, IP)
# dentro de la ventana. Superarlos devuelve 429 con cabecera Retry-After.
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300

# --- Reset de contraseña por email ---
# Caducidad del enlace y peticiones de reset por (email, IP).
PASSWORD_RESET_TTL_MINUTES=30
PASSWORD_RESET_MAX_REQUESTS=3
# URL pública del frontend: es donde apunta el enlace del correo.
PUBLIC_APP_URL=http://localhost:5173
# SMTP. Con SMTP_HOST vacío NO se envían correos: en desarrollo el token se
# registra en el log (por eso se puede probar el flujo sin servidor de correo).
# En producción, rellénalo o el reset de contraseña no llegará a nadie.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM=no-reply@loopy.local

# --- CORS (frontend dev) ---
CORS_ORIGINS=["http://localhost:5173"]

# --- Push (VAPID) ---
# Generar par: python -m pywebpush ...  (se rellena cuando toque el módulo push)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com