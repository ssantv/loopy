# --- Core configuration ---
# Secreto para firmar/encriptar; generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_NAME=Loopy
ENV=development
DEBUG=true

# --- Database ---
# Local por SQLite (dev rápido sin Docker) o Postgres (producción).
DATABASE_URL=sqlite+aiosqlite:///./loopy_dev.db
# Producción:
# DATABASE_URL=postgresql+asyncpg://loopy:secret@db:5432/loopy

# --- Security / sessions ---
# Arquitectura: sesiones con token opaco en BD, sin JWT.
SESSION_TOKEN_BYTES=32
SESSION_TTL_DAYS=30

# Rate limit del login (fuerza bruta): intentos fallidos por (email, IP)
# dentro de la ventana. Superarlos devuelve 429 con cabecera Retry-After.
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300

# --- CORS (frontend dev) ---
CORS_ORIGINS=["http://localhost:5173"]

# --- Push (VAPID) ---
# Generar par: python -m pywebpush ...  (se rellena cuando toque el módulo push)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com