# --- Despliegue Loopy en VPS (Hostinger) ---
# Copiar este archivo a .env y rellenar valores. No comprometer el .env.
APP_NAME=Loopy
ENV=production
DEBUG=false

# Secreto: python -c "import secrets; print(secrets.token_urlsafe(48))"
# SECRET=

# Postgres — en prod la API y la BD corren en la misma red interna.
POSTGRES_USER=loopy
POSTGRES_PASSWORD=passphrase_cambiar
POSTGRES_DB=loopy
DATABASE_URL=postgresql+asyncpg://loopy:passphrase_cambiar@db:5432/loopy

# CORS: origen exacto del frontend en el VPS
CORS_ORIGINS=["https://loopy.midominio.com"]

# Rate limit del login (fuerza bruta): fallos por (email, IP) en la ventana
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300

# VAPID (rellenar: python -m pywebpush --gen-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@midominio.com